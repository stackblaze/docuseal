<% account = @submitter&.account %>
<a href="<%= root_path %>" class="mx-auto text-xl md:text-2xl font-semibold items-center flex space-x-2.5">
  <% if account&.logo&.attached? %>
    <%= image_tag account.logo, alt: account.name, class: 'h-9 md:h-10 w-auto max-w-[10rem] object-contain' %>
    <span><%= account.name %></span>
  <% else %>
    <%= render 'shared/logo', class: 'w-8 h-8' %>
    <span><%= Docuseal.product_name %></span>
  <% end %>
</a>
