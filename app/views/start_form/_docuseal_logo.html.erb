<% account = @template&.account %>
<a href="/" class="flex justify-center items-center">
  <% if account&.logo&.attached? %>
    <%= image_tag account.logo, alt: account.name, class: 'h-12 w-auto max-w-[12rem] object-contain mr-3' %>
    <h1 class="text-3xl font-semibold text-center"><%= account.name %></h1>
  <% else %>
    <span class="mr-3">
      <%= render 'shared/logo', width: '40px', height: '40px' %>
    </span>
    <h1 class="text-3xl font-semibold text-center"><%= Docuseal.product_name %></h1>
  <% end %>
</a>
