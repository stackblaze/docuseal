<%= render 'shared/navbar_warning' %>
<div class="border-b border-base-300 mb-4">
  <div class="max-w-6xl mx-auto px-4 md:px-2 h-[60px] flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <a href="<%= root_path %>" class="text-[15px] font-semibold items-center flex space-x-2.5">
        <%= render 'shared/title' %>
      </a>
    </div>
    <div class="flex space-x-2">
      <% if request.path != new_user_session_path && request.path != setup_index_path %>
        <%= link_to new_user_session_path({ lang: params[:lang] }.compact_blank), class: 'font-medium text-[13.5px]' do %>
          <span class="flex items-center justify-center space-x-1">
            <%= svg_icon('login', class: 'w-5 h-5') %>
            <span><%= t('sign_in') %></span>
          </span>
        <% end %>
      <% end %>
      <% if Docuseal.multitenant? && !request.path.in?([registration_path, new_registration_path]) %>
        <%= link_to registration_path({ lang: params[:lang] }.compact_blank), class: 'btn btn-primary btn-sm h-9 min-h-9 normal-case text-[13.5px]' do %>
          <span class="flex items-center justify-center space-x-1">
            <span class="hidden sm:block capitalize"><%= t('create_free_account') %></span>
            <span class="md:hidden"><%= t('sign_up') %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
